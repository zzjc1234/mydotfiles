#!/usr/bin/env python3
"""A small CLI focus timer with a Mako card and a Waybar compact view."""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import html
import json
import math
import os
import re
import subprocess
import sys
import time
import uuid
from pathlib import Path
from typing import Iterator

APP_NAME = "FocusTimer"
NO_NOTIFY = os.environ.get("FOCUS_TIMER_NO_NOTIFY") == "1"
DURATION_FORMAT = "H:M:S"
DURATION_PATTERN = re.compile(r"^(\d+):(\d+):(\d+)$")


def get_state_dir() -> Path:
    override = os.environ.get("FOCUS_TIMER_STATE_DIR")
    if override:
        return Path(override)
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "focus-timer"


STATE_DIR = get_state_dir()
STATE_PATH = STATE_DIR / "state.json"
LOCK_PATH = STATE_DIR / "state.lock"
PID_PATH = STATE_DIR / "watch.pid"


class TimerError(RuntimeError):
    pass


def ensure_state_dir() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)


@contextlib.contextmanager
def state_lock() -> Iterator[None]:
    ensure_state_dir()
    with LOCK_PATH.open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def read_state() -> dict | None:
    try:
        state = json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None
    if not isinstance(state, dict) or "phase" not in state or "duration" not in state:
        return None
    return state


def write_state(state: dict) -> None:
    ensure_state_dir()
    temporary = STATE_PATH.with_name(f".{STATE_PATH.name}.{os.getpid()}.tmp")
    temporary.write_text(json.dumps(state, ensure_ascii=False), encoding="utf-8")
    os.replace(temporary, STATE_PATH)


def remove_state() -> None:
    try:
        STATE_PATH.unlink()
    except FileNotFoundError:
        pass


def parse_duration(value: str) -> int:
    matches = DURATION_PATTERN.fullmatch(value.strip())
    if not matches:
        raise TimerError(f"时长必须使用非负整数 H:M:S，例如 0:50:0")
    hours, minutes, seconds = (int(part) for part in matches.groups())
    total = hours * 3600 + minutes * 60 + seconds

    if total <= 0:
        raise TimerError("时长必须大于零")
    return total


def format_duration(seconds: int) -> str:
    seconds = max(0, int(seconds))
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    return f"{hours:02d}:{minutes:02d}:{seconds:02d}"


def snapshot(state: dict, now: float | None = None) -> dict:
    now = time.time() if now is None else now
    phase = state.get("phase", "finished")
    if phase == "running":
        remaining = max(0, math.ceil(float(state.get("ends_at", now)) - now))
    else:
        remaining = max(0, int(state.get("remaining", 0)))
    return {
        "phase": phase,
        "remaining": remaining,
        "duration": int(state["duration"]),
        "now": now,
    }


def finish_if_needed(state: dict, now: float | None = None) -> tuple[dict, dict, bool]:
    current = snapshot(state, now)
    if state.get("phase") != "running" or current["remaining"] > 0:
        return state, current, False

    state["phase"] = "finished"
    state["remaining"] = 0
    state.pop("ends_at", None)
    state["view"] = "expanded"
    current = snapshot(state, now)
    return state, current, True


def card_payload(state: dict, current: dict) -> tuple[str, str, str, int]:
    title = html.escape(str(state.get("title", "未命名任务")))
    total = format_duration(current["duration"])
    remaining = format_duration(current["remaining"])
    clock = time.strftime("%H:%M:%S", time.localtime(current["now"]))
    phase = current["phase"]

    if phase == "finished":
        return (
            f"⏰ {title}",
            f'<span size="large">总时长 {total}</span>\n'
            '<span size="xx-large"><b>时间到了</b></span>',
            "critical",
            100,
        )
    if phase == "paused":
        progress = round((current["duration"] - current["remaining"]) * 100 / current["duration"])
        return (
            f"⏸ {title}",
            f'<span size="large">暂停于 {clock} · 总时长 {total}</span>\n'
            f'<span size="xx-large"><b>保留 {remaining}</b></span>',
            "normal",
            progress,
        )

    progress = round((current["duration"] - current["remaining"]) * 100 / current["duration"])
    return (
        f"⏱ {title}",
        f'<span size="large">现在 {clock} · 总时长 {total}</span>\n'
        f'<span size="xx-large"><b>剩余 {remaining}</b></span>',
        "normal",
        progress,
    )


def show_card(state: dict, current: dict) -> int | None:
    if NO_NOTIFY:
        return state.get("notification_id")

    summary, body, urgency, progress = card_payload(state, current)
    command = [
        "notify-send",
        "--app-name",
        APP_NAME,
        "--urgency",
        urgency,
        "--expire-time",
        "0",
        "--print-id",
        "--hint",
        f"int:value:{progress}",
    ]
    notification_id = state.get("notification_id")
    if notification_id:
        command.extend(["--replace-id", str(notification_id)])
    command.extend([summary, body])
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    try:
        return int(result.stdout.strip())
    except ValueError:
        return notification_id if isinstance(notification_id, int) else None


def dismiss_card(notification_id: int | None) -> None:
    if NO_NOTIFY or not notification_id:
        return
    subprocess.run(
        ["makoctl", "dismiss", "--no-history", "-n", str(notification_id)],
        capture_output=True,
        check=False,
    )


def play_alarm() -> None:
    if NO_NOTIFY:
        return
    subprocess.Popen(
        ["canberra-gtk-play", "-i", "alarm-clock-elapsed"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def save_notification_id(token: str, notification_id: int | None) -> bool:
    if not notification_id:
        return False
    with state_lock():
        state = read_state()
        if not state or state.get("token") != token:
            return False
        if state.get("view") != "expanded":
            return False
        state["notification_id"] = notification_id
        write_state(state)
        return True


def render_current_card(state: dict, current: dict) -> None:
    notification_id = show_card(state, current)
    if notification_id and not save_notification_id(str(state.get("token", "")), notification_id):
        dismiss_card(notification_id)


def current_state() -> tuple[dict, dict, bool] | tuple[None, None, bool]:
    with state_lock():
        state = read_state()
        if not state:
            return None, None, False
        state, current, finished_now = finish_if_needed(state)
        if finished_now:
            write_state(state)
        return state, current, finished_now


def read_watcher_pid() -> int | None:
    try:
        return int(PID_PATH.read_text(encoding="utf-8").strip())
    except (FileNotFoundError, ValueError, OSError):
        return None


def watcher_is_alive() -> bool:
    pid = read_watcher_pid()
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def ensure_watcher() -> None:
    if watcher_is_alive():
        return
    ensure_state_dir()
    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "_watch"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def watch() -> None:
    ensure_state_dir()
    PID_PATH.write_text(str(os.getpid()), encoding="utf-8")
    try:
        while True:
            state, current, finished_now = current_state()
            if not state or not current:
                return

            if state.get("view") == "expanded":
                render_current_card(state, current)
            if finished_now:
                play_alarm()
            if current["phase"] == "finished":
                return
            time.sleep(1)
    finally:
        if read_watcher_pid() == os.getpid():
            try:
                PID_PATH.unlink()
            except FileNotFoundError:
                pass


def clean_title(title: str) -> str:
    title = " ".join(title.split())
    if not title:
        raise TimerError("任务名称不能为空")
    return title[:80]


def start_timer(duration_text: str, title: str) -> None:
    duration = parse_duration(duration_text)
    title = clean_title(title)
    with state_lock():
        previous = read_state()
        state = {
            "token": uuid.uuid4().hex,
            "title": title,
            "duration": duration,
            "remaining": duration,
            "ends_at": time.time() + duration,
            "phase": "running",
            "view": "expanded",
            "notification_id": None,
        }
        write_state(state)

    if previous:
        dismiss_card(previous.get("notification_id"))
    current = snapshot(state)
    render_current_card(state, current)
    ensure_watcher()
    print(f"已开始：{title}（{format_duration(duration)}）")


def pause_timer() -> None:
    with state_lock():
        state = read_state()
        if not state:
            raise TimerError("没有正在执行的倒计时")
        state, current, _ = finish_if_needed(state)
        if state["phase"] != "running":
            write_state(state)
            raise TimerError("倒计时当前不在执行")
        state["phase"] = "paused"
        state["remaining"] = current["remaining"]
        state.pop("ends_at", None)
        current = snapshot(state)
        write_state(state)

    if state.get("view") == "expanded":
        render_current_card(state, current)
    ensure_watcher()
    print(f"已暂停：{state['title']}")


def resume_timer() -> None:
    with state_lock():
        state = read_state()
        if not state:
            raise TimerError("没有可继续的倒计时")
        if state.get("phase") != "paused":
            raise TimerError("倒计时当前未暂停")
        state["phase"] = "running"
        state["ends_at"] = time.time() + int(state["remaining"])
        current = snapshot(state)
        write_state(state)

    if state.get("view") == "expanded":
        render_current_card(state, current)
    ensure_watcher()
    print(f"已继续：{state['title']}")


def cancel_timer() -> None:
    with state_lock():
        state = read_state()
        if not state:
            raise TimerError("没有可取消的倒计时")
        remove_state()
    dismiss_card(state.get("notification_id"))
    print(f"已取消：{state['title']}")


def status_timer() -> None:
    state, current, _ = current_state()
    if not state or not current:
        raise TimerError("没有倒计时")

    with state_lock():
        stored = read_state()
        if not stored:
            raise TimerError("没有倒计时")
        stored["view"] = "expanded"
        write_state(stored)
        state = stored
        current = snapshot(state)

    render_current_card(state, current)
    if current["phase"] != "finished":
        ensure_watcher()
    print(f"{state['title']}：{current['phase']}，剩余 {format_duration(current['remaining'])}")


def toggle_status_view() -> None:
    state, current, _ = current_state()
    if not state or not current:
        raise TimerError("没有倒计时")

    with state_lock():
        stored = read_state()
        if not stored:
            raise TimerError("没有倒计时")
        expanded = stored.get("view") != "expanded"
        stored["view"] = "expanded" if expanded else "compact"
        write_state(stored)
        state = stored
        current = snapshot(state)

    if expanded:
        render_current_card(state, current)
        if current["phase"] != "finished":
            ensure_watcher()
        print("已展开 Mako 倒计时卡片")
    else:
        dismiss_card(state.get("notification_id"))
        print("已切换为 Waybar 精简状态")


def waybar() -> None:
    state, current, _ = current_state()
    result: dict[str, str] = {"text": "", "class": "idle", "tooltip": ""}
    if state and current and state.get("view") == "compact" and current["phase"] != "finished":
        title = str(state.get("title", "未命名任务"))
        if current["phase"] == "paused":
            text = f"󱎫 {title} 已暂停"
            status = "已暂停"
            css_class = "paused"
        else:
            text = f"󱎫 {title} 正在执行"
            status = "正在执行"
            css_class = "running"
        result = {
            "text": text,
            "class": css_class,
            "tooltip": (
                f"{title}\\r{status}\\r总时长：{format_duration(current['duration'])}"
                f"\\r剩余：{format_duration(current['remaining'])}"
                "\\rSuper+Alt+Y：展开/收起大卡片"
            ),
        }
    print(json.dumps(result, ensure_ascii=False))


def form_error(zenity: str, message: str) -> None:
    subprocess.run(
        [
            zenity,
            "--error",
            "--title=倒计时未启动",
            "--text",
            message,
            "--width=420",
            "--modal",
        ],
        capture_output=True,
        check=False,
    )


def prompt_start() -> None:
    zenity = os.environ.get("FOCUS_TIMER_ZENITY", "zenity")
    separator = "\x1f"
    result = subprocess.run(
        [
            zenity,
            "--forms",
            "--title=新建倒计时",
            "--text=时、分、秒均为非负整数，不限位数；任务描述必填。\n示例：小时 0，分钟 25，秒 0；超过 59 的分钟或秒会自动归一化。\n键盘：Tab/Shift+Tab 切换字段，Esc 取消。",
            "--width=580",
            "--height=340",
            "--modal",
            "--ok-label=开始",
            "--cancel-label=取消",
            "--add-entry=小时",
            "--add-entry=分钟",
            "--add-entry=秒",
            "--add-entry=任务描述（必填）",
            f"--separator={separator}",
        ],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return

    fields = result.stdout.rstrip("\n").split(separator)
    if len(fields) != 4:
        form_error(zenity, "表单数据不完整，请重新填写。")
        return
    hours, minutes, seconds, title = fields
    try:
        start_timer(f"{hours}:{minutes}:{seconds}", title)
    except TimerError as exc:
        form_error(zenity, str(exc))


def notify_error(message: str) -> None:
    if NO_NOTIFY:
        return
    subprocess.run(
        [
            "notify-send",
            "--app-name",
            "FocusTimer Error",
            "--urgency",
            "low",
            "--expire-time",
            "3000",
            "Focus Timer",
            message,
        ],
        capture_output=True,
        check=False,
    )


def self_test() -> None:
    assert parse_duration("0:50:0") == 3000
    assert parse_duration("1:30:0") == 5400
    assert parse_duration("1:90:120") == 9120
    assert format_duration(3000) == "00:50:00"
    try:
        parse_duration("50m")
    except TimerError:
        pass
    else:
        raise AssertionError("ambiguous duration accepted")
    try:
        parse_duration("1:two:0")
    except TimerError:
        pass
    else:
        raise AssertionError("non-numeric minute accepted")
    state = {
        "duration": 10,
        "remaining": 10,
        "ends_at": 110,
        "phase": "running",
        "view": "expanded",
    }
    assert snapshot(state, 100)["remaining"] == 10
    state, current, finished = finish_if_needed(state, 110)
    assert finished and current["phase"] == "finished" and current["remaining"] == 0
    print("focus-timer self-test: ok")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    start = commands.add_parser(
        "start",
        help="开始：focus-timer start 0:50:0 '任务名称'",
    )
    start.add_argument("duration")
    start.add_argument("title", nargs="+")
    commands.add_parser("prompt", help="打开时、分、秒和任务描述表单")
    commands.add_parser("pause")
    commands.add_parser("resume")
    commands.add_parser("cancel")
    commands.add_parser("status", help="显示 Mako 大卡片")
    commands.add_parser("status-toggle", help="切换 Mako 大卡片与 Waybar 精简状态")
    commands.add_parser("waybar", help=argparse.SUPPRESS)
    commands.add_parser("_watch", help=argparse.SUPPRESS)
    commands.add_parser("self-test", help=argparse.SUPPRESS)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        if args.command == "start":
            start_timer(args.duration, " ".join(args.title))
        elif args.command == "prompt":
            prompt_start()
        elif args.command == "pause":
            pause_timer()
        elif args.command == "resume":
            resume_timer()
        elif args.command == "cancel":
            cancel_timer()
        elif args.command == "status":
            status_timer()
        elif args.command == "status-toggle":
            toggle_status_view()
        elif args.command == "waybar":
            waybar()
        elif args.command == "_watch":
            watch()
        elif args.command == "self-test":
            self_test()
    except TimerError as error:
        if args.command == "waybar":
            print(json.dumps({"text": "", "class": "idle", "tooltip": ""}))
            return 0
        print(f"focus-timer: {error}", file=sys.stderr)
        if args.command != "_watch":
            notify_error(str(error))
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
